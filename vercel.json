{
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/f/:path*",
      "destination": "/finder/index.html"
    },
    {
      "source": "/f",
      "destination": "/finder/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/authority/:path*",
      "destination": "/authority/index.html"
    },
    {
      "source": "/owner/:path*",
      "destination": "/owner/index.html"
    }
  ]
}
